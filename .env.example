# 115 网盘登录 Cookie（必填）
COOKIE_115=your_115_cookie_here

# 服务端口（默认 8000）
APP_PORT=8000

# 调试模式（默认 false）
DEBUG=false

# 代理（可选，海外源走代理）
# HTTP_PROXY=http://127.0.0.1:7890

# 跨盘中转: 夸克网盘 Cookie（可选，启用夸克→115 跨盘转存）
# QUARK_COOKIE=your_quark_cookie_here

# 跨盘中转: 阿里云盘 Refresh Token（可选，启用阿里→115 跨盘转存）
# ALIYUN_REFRESH_TOKEN=your_aliyun_refresh_token_here

# 转存后自动清理临时文件（默认 true）
AUTO_CLEAN_TEMP=true
